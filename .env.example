# Database settings. On Liberty (Docker/OpenShift) the datasource is defined once, in docker/server.xml, and the
# application looks it up through JNDI (jdbc/orderManagementDS). These variables feed that datasource.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=order_management
DB_USERNAME=change_me
DB_PASSWORD=change_me

# Optional
# APP_LOG_LEVEL=INFO
# SQL_INIT_MODE=always

# Local runs only (mvn spring-boot:run -Dspring-boot.run.profiles=dev) - no JNDI outside Liberty
# DB_URL=jdbc:postgresql://localhost:5432/order_management
